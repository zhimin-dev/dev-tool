{
  "name": "知敏工具",
  "description": "This is zhimin chrome extension",
  "version": "1.3.0",
  "manifest_version": 3,
  "permissions": [
    "alarms", 
    "tabs", 
    "bookmarks", 
    "contextMenus",
    "declarativeContent",
    "notifications",
    "webRequest",
    "webRequestBlocking", 
		"storage"
  ],
  "background": {
    "service_worker": "js/background.js"
  },
  "icons":
	{
		"16": "images/icon.png",
		"48": "images/icon.png",
		"128": "images/icon.png"
	},
  "content_scripts": [
		{
      "matches": ["<all_urls>"],
			"js": ["js/axios.min.js", "js/content_script.js"],
			"run_at": "document_start"
		}
  ],
  "options_page": "options.html",
  "action": {
    "default_icon" : "images/icon.png",
    "default_title": "知敏工具",
    "default_popup": "index.html"
  },
  "homepage_url": "https://github.com/zhimin-dev"
}
