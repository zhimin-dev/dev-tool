{
  "name": "dev-tool",
  "description": "a dev-tool for chrome extension",
  "version": "2.0.3",
  "manifest_version": 3,
  "permissions": [
    "alarms", 
    "notifications",
    "webRequest",
		"storage",
    "nativeMessaging",
    "http://*/"
  ],
  "background": {
    "service_worker": "js/background.js"
  },
  "icons": {
		"16": "icon.png",
		"48": "icon.png",
		"128": "icon.png"
	},
  "content_scripts": [
		{
      "matches": ["<all_urls>"],
			"js": ["js/axios.min.js", "js/content_script.js"],
			"run_at": "document_start"
		}
  ],
  "options_page": "index.html",
  "action": {
    "default_icon" : "icon.png",
    "default_title": "dev-tool",
    "default_popup": "popup.html"
  },
  "homepage_url": "https://github.com/zhimin-dev/dev-tool"
}
